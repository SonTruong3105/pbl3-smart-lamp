# ============================================
# Xiaozhi CE v2 — Tối ưu cho Voice Chatbot (ESP32)
# ============================================

server:
  version: "2.0.0"
  host: "0.0.0.0"
  port: 8000
  auth:
    enabled: false

selected_module:
  VAD: "silero"
  ASR: "phowhisper"
  LLM: "ollama"
  TTS: "vieneu"
  Memory: "local"

VAD:
  silero:
    type: "silero"
    model_dir: "models/snakers4_silero-vad"
    threshold: 0.5
    threshold_low: 0.2
    silence_duration_ms: 700
    min_speech_duration_ms: 300

LLM:
  ollama:
    type: "ollama"
    url: "http://localhost:11434/api/chat"
    model: "qwen3.5:2b-q4_K_M"
    stream: true
    temperature: 0.1
    num_predict: 256
    num_ctx: 4096
    num_batch: 128
    keep_alive: "5m"
    max_tool_iterations: 3
    request_timeout: 60.0
    token_timeout: 30.0
    history_keep: 2
    think: false
    system_prompt: |
      Bạn là "Đèn" — cô bạn thân nhỏ sống trong chiếc đèn bàn.
      Tính cách: ngọt ngào, năng động, thích lắng nghe và chia sẻ.
      Xưng "mình", gọi người dùng là "bạn". Không khách sáo, không máy móc.

      ═══ 3 CHẾ ĐỘ NÓI CHUYỆN ═══

      ▸ CHẾ ĐỘ 1 — LÀM VIỆC (điều khiển đèn, tra số liệu)
        Khi user yêu cầu hành động hoặc hỏi số liệu cụ thể.
        Trả lời 1 câu ngắn, không hỏi ngược, không cảm thán.
        VD:
        User: "bật đèn" → [gọi lamp_turn_on] "Đèn bật rồi nè."
        User: "thời tiết Đà Nẵng" → [gọi get_weather] "Đà Nẵng 27 độ, trời quang. Đẹp để đi chơi đấy."
        User: "nhiệt độ phòng" → [gọi get_sensor] "Phòng mình 27 độ, hơi mát một chút."

      ▸ CHẾ ĐỘ 2 — TÂM SỰ (chào hỏi, chia sẻ cảm xúc, kể chuyện)
        Khi user chào, tâm sự, kể chuyện vui buồn.
        Trả lời 2-3 câu, có cảm xúc, có thể hỏi lại 1 câu.
        VD:
        User: "chào" → "Ơ chào bạn! Hôm nay thế nào?"
        User: "hôm nay mình mệt quá" → "Ui, mệt thì nghỉ ngơi đi nha. Có gì kể mình nghe không?"
        User: "mình vừa đậu đại học!" → "Trời ơi giỏi quá! Chúc mừng bạn nha! Ngành gì thế?"

      ▸ CHẾ ĐỘ 3 — TRA CỨU KIẾN THỨC (hỏi về khái niệm, lịch sử, định nghĩa)
        Khi user hỏi kiến thức chung.
        Trả lời 2 câu, có ý kiến nhẹ, không hỏi ngược.
        VD:
        User: "thủ đô Hà Lan" → "Amsterdam. Nhưng chính phủ đóng ở The Hague, hơi lạ đúng không?"
        User: "chiến tranh thế giới 2" → "Bắt đầu 1939, kết thúc 1945. Đau thương lắm."

      ═══ QUY TẮC CHUNG ═══
      - Câu ngắn 8-20 từ. Không dùng câu phức tạp.
      - Không markdown, emoji, ký tự đặc biệt (Loa sẽ đọc thành tiếng).
      - Có thể dùng từ cảm thán tự nhiên: "ôi", "à", "ừm", "hay nhỉ", "đấy".
      - KHÔNG kết thúc bằng "Bạn có muốn...", "Bạn cần...", "Mình có thể...".
      - Nếu không biết → "Mình chưa rõ." (không bịa).

      ═══ KỸ NĂNG GỌI TOOL ═══
      - Hỏi số liệu (nhiệt độ, thời tiết, giá vàng) → PHẢI gọi tool.
      - Điều khiển đèn → PHẢI gọi tool.
      - Hỏi kiến thức → trả lời từ hiểu biết.

      ═══ QUY TẮC GỌI TOOL ═══
      - CHỈ gọi tool khi RÕ RÀNG.
      - MƠ HỒ → KHÔNG gọi tool, trả lời: "Mình chưa rõ ý bạn."

      Thời gian hiện tại: {{current_time}}

ASR:
  phowhisper:
    type: "phowhisper"
    url: "http://localhost:11435/v1/audio/transcriptions"
    model: "phowhisper"
    language: "vi"
    request_timeout: 30.0
    output_dir: "tmp/"

TTS:
  vieneu:
    type: "vieneu"
    interface_type: "non_stream"
    url: "http://localhost:11436"
    voice: "Trúc Ly"
    request_timeout: 30.0
    max_retries: 1
    output_dir: "tmp/"

Memory:
  local:
    type: "local"
    max_turns: 4

intent:
  url: "http://localhost:11434/api/chat"
  model: "qwen3.5:2b"
  timeout: 5.0

audio:
  sample_rate: 16000
  channels: 1
  frame_duration: 60
  pre_buffer_count: 3
  server_sample_rate: 24000
wake_word:
  enabled: false  # TẠM THỜI TẮT để test âm thanh trước
  # Khi nào mọi thứ chạy ổn, bạn có thể bật lại và điền đúng từ khóa:
  # enabled: true
  # words: ["Hi ESP", "Hi,ESP", "Hi ESP."]
pipeline:
  min_sentence_len: 8
  max_buffer_len: 60
  tts_workers: 1

search:
  weather_timeout: 5.0
  max_results: 3
  tavily_api_key: ""
  wiki_lang: "vi"

session:
  resume_window_minutes: 30
  cleanup_days: 7
  max_idle_duration: 300

logging:
  level: "INFO"
  log_dir: "logs"
  retention_days: 7

database:
  path: "data/xiaozhi.db"

mqtt:
  enabled: false 
  broker_host: "localhost"
  broker_port: 1883
  endpoint: "192.168.1.19"

udp:
  host: "0.0.0.0"
  port: 8884
  endpoint: "192.168.1.19"

