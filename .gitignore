# ==============================
# Xiaozhi Server - Custom Ignore
# ==============================

# Environment and secrets
.env
.env.*
!.env.example
*.pem
*.key

# Backup files
*.bak
*.backup
*.old
*.orig

# Code dumps and temporary scripts
app_code_dump.txt
dump_code.py
fix.py

# Runtime data (review before enabling)
# data/
# models/

# Audio and generated files
audio_test/
recordings/
*.wav
*.mp3
*.pcm

# Runtime logs
logs/
*.log

# Temporary files
*.tmp
*.swp
*~

# Python virtual environments
venv/
.venv/
# Python cache
__pycache__/
*.py[cod]

# Local data and AI models
data/
models/